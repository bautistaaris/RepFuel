# RepFuel — environment variables
# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Local dev (Docker): postgresql://repfuel:repfuel@localhost:5432/repfuel
# Production self-hosted: postgresql://USER:PASSWORD@postgres:5432/DBNAME (compose service name)
DATABASE_URL="postgresql://repfuel:repfuel@localhost:5432/repfuel"

# Secret to sign session cookies + CSRF tokens. >= 32 random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Allow new signups from the public /register page.
# Set to "false" to invite-only mode.
ALLOW_PUBLIC_REGISTRATION="true"

# If "true", users must verify email before accessing the app.
REQUIRE_EMAIL_VERIFICATION="false"

# Trust the upstream proxy for x-forwarded-* headers and HTTPS detection.
# Set to "true" when running behind Cloudflare Tunnel / reverse proxy.
TRUST_PROXY="false"

# Rate limiting backend: "memory" (single-instance) or "postgres" (persistent).
RATE_LIMIT_BACKEND="memory"

# Email provider for verification + password reset.
# "console" (default, prints to stdout) or "resend".
EMAIL_PROVIDER="console"
EMAIL_FROM="RepFuel <noreply@repfuel.app>"
EMAIL_API_KEY=""

# Nutrition AI parser (optional).
# "none" (default) uses local ManualNutritionParser; "openai" enables OpenAINutritionParser.
NUTRITION_AI_PROVIDER="none"
NUTRITION_AI_API_KEY=""
NUTRITION_AI_MODEL="gpt-4o-mini"

# Public app URL (used for absolute links in emails and OG).
# Dev: http://localhost:3000
# Prod: https://your-domain.example
APP_URL="http://localhost:3000"

NODE_ENV="development"