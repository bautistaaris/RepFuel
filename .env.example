# RepFuel — variables de entorno
# Copiá este archivo a `.env` y completá los valores.

# Base de datos SQLite
DATABASE_URL="file:./data/repfuel.db"

# Secret para firmar sesiones y CSRF (mínimo 32 caracteres random)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Credenciales del administrador inicial (usadas solo por `npm run seed:admin`)
ADMIN_EMAIL="admin@repfuel.local"
ADMIN_PASSWORD=""

# Proveedor de IA para parseo nutricional: "none" (default) | "openai"
NUTRITION_AI_PROVIDER="none"
NUTRITION_AI_API_KEY=""
NUTRITION_AI_MODEL="gpt-4o-mini"

# URL pública (usada para canonical/OG). En LAN con Tailscale: http://100.x.x.x:3000
APP_URL="http://localhost:3000"

# Entorno: development | production
NODE_ENV="development"