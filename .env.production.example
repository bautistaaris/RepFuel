# RepFuel — production environment variables (self-hosted)
# Copy to `.env.production` on the host. NEVER commit real values.
#
# Layout on the host (recommended):
#   /srv/repfuel/
#     app/                 # this repo
#     config/.env.production
#     backups/             # pg_dump output (created by scripts/backup-postgres.sh)
#     secrets/             # additional sensitive files (optional)

########################################
# PostgreSQL (running in Docker compose)
########################################
POSTGRES_DB=repfuel
POSTGRES_USER=repfuel
POSTGRES_PASSWORD=__GENERATE_AND_STORE_SECURELY__

########################################
# App
########################################
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=__GENERATE_AND_STORE_SECURELY__

# Public URL where users access the app (Cloudflare Tunnel public hostname)
# Must NOT include a trailing slash.
APP_URL=https://repfuel.example.com

# Trust the upstream proxy (Cloudflare Tunnel) for x-forwarded-* headers
# and HTTPS detection. Required when running behind Cloudflare.
TRUST_PROXY=true

########################################
# Registration & email
########################################
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=true

# Email provider: "console" (dev), "resend" (prod).
EMAIL_PROVIDER=resend
EMAIL_FROM=RepFuel <noreply@repfuel.example.com>
EMAIL_API_KEY=__RESEND_API_KEY__

########################################
# Rate limiting backend
# "memory" = in-process (single-instance only)
# "postgres" = persistent across restarts/instances (recommended)
########################################
RATE_LIMIT_BACKEND=postgres

########################################
# Optional: AI nutrition parser
########################################
NUTRITION_AI_PROVIDER=none
NUTRITION_AI_API_KEY=
NUTRITION_AI_MODEL=gpt-4o-mini

########################################
# Cloudflare Tunnel
########################################
# Token from: Cloudflare Zero Trust → Tunnels → <tunnel> → Configure
# Copy the token (NOT the tunnel ID).
CLOUDFLARE_TUNNEL_TOKEN=__CLOUDFLARE_TUNNEL_TOKEN__

########################################
# Backups (used by scripts/backup-postgres.sh on the host)
########################################
BACKUP_DIR=/srv/repfuel/backups

# Optional offsite target via rclone (e.g. "remote:bucket/repfuel-backups")
OFFSITE_REMOTE=